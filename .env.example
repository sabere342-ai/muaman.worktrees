# I Tech Store Management Application — Environment Variables
# Phase C: Cloud Backend Foundation
#
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# NEVER commit service_role keys, passwords, or tokens.

# =============================================================================
# Supabase Configuration
# =============================================================================

# Supabase project URL (public, safe for client use)
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (publishable) key — safe for client-side use with RLS
# This key is designed to be public and is protected by RLS policies
SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# Environment Selection
# =============================================================================

# Current environment: development | test | staging | production
APP_ENV=development

# =============================================================================
# Supabase Service Role Key (SERVER-SIDE ONLY)
# NEVER include this in Flutter source code or client binaries.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Database Connection (Supabase CLI local development)
# =============================================================================
# These are managed by the Supabase CLI and do not need manual configuration.

# DB_HOST=localhost
# DB_PORT=54322
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-local-db-password
